# Required. Create an application/bot at https://discord.com/developers/applications
DISCORD_TOKEN=replace_with_your_bot_token

# Optional: MyAnimeList developer API client ID (MAL search is disabled if empty).
MAL_CLIENT_ID=

# Optional: fast slash-command iteration in one test server. Leave empty for global commands.
DEV_GUILD_ID=

# Persistent local database. Keep this under the project directory on the VM, not /tmp.
DATABASE_PATH=./data/tracker.sqlite3

# The bot checks tracked titles on a 60-second interval. Large lists may take longer per cycle.
POLL_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=15
MAX_RESPONSE_BYTES=2000000
BOT_USER_AGENT=AnimeMangaTracker/1.0 (Discord community bot)
LOG_LEVEL=INFO

# Optional: replace the default Crunchyroll News RSS feed with feeds you are permitted to use. Format:
# RSS_FEEDS="Publisher News|https://example.org/feed.xml|official;Industry News|https://example.net/rss|third-party"
# Only set the `official` flag for first-party publisher/studio/platform announcements.
# If omitted, the bot uses the Crunchyroll News RSS feed classified as third-party reporting.
